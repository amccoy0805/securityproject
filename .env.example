# Aegis AI Gateway environment configuration
# Copy to .env and edit. Never commit .env to source control.

# --- Core ---
AEGIS_ENV=dev
AEGIS_HOST=0.0.0.0
AEGIS_PORT=8080
AEGIS_LOG_LEVEL=INFO

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AEGIS_SECRET_KEY=change-me-please-this-is-not-secure
AEGIS_SESSION_COOKIE_SECURE=false
AEGIS_ALLOWED_HOSTS=*

# --- Database ---
# Default: local SQLite. For production use Postgres:
#   AEGIS_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/aegis
AEGIS_DATABASE_URL=sqlite+aiosqlite:///./data/aegis.db

# --- Bootstrap admin (created on first run if no users exist) ---
AEGIS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
AEGIS_BOOTSTRAP_ADMIN_PASSWORD=changeme-strong-password
AEGIS_BOOTSTRAP_TENANT_NAME=Acme Corp

# --- Upstream provider credentials (held server-side; never sent to clients) ---
# These are optional defaults; per-tenant overrides live in the DB.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Policy defaults ---
AEGIS_DEFAULT_COMPLIANCE_PROFILES=baseline
AEGIS_DEFAULT_BLOCK_ON_HIGH_SEVERITY=true

# --- Distributed backend (optional) ---
# When set, budgets and loop-detection state live in Redis so they are
# shared across replicas. Leave blank for a single-node deployment.
# AEGIS_REDIS_URL=redis://localhost:6379/0
AEGIS_REDIS_URL=
